#!/usr/bin/env bash
# waybar-style — switch waybar styles.
# Port of binnewbs' WaybarStyles.sh (rofi) for fuzzel. Bound to $mod+Ctrl+b.
set -euo pipefail

STYLES_DIR="$HOME/.config/waybar/styles"
ACTIVE_STYLE="$HOME/.config/waybar/style.css"

choice="$(find -L "$STYLES_DIR" -maxdepth 1 -type f -name '*.css' \
    -exec basename {} .css \; | sort \
    | fuzzel --dmenu --prompt 'Waybar style: ')" || exit 0
[ -z "${choice:-}" ] && exit 0

ln -sfn "$STYLES_DIR/$choice.css" "$ACTIVE_STYLE"
"$HOME/.config/sway/scripts/waybar-restart" &
notify-send 'Waybar style' "$choice"
